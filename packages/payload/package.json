{
  "name": "@news-spend-media/payload",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./collections": "./src/collections/index.ts",
    "./blocks": "./src/blocks/index.ts",
    "./fields": "./src/fields/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./access": "./src/access/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./types": "./src/payload-types.ts",
    "./payload-generated-schema": "./src/payload-generated-schema.ts",
    "./*": "./src/*.ts",
    "./access/*": "./src/access/*/index.ts",
    "./blocks/*": "./src/blocks/*/index.ts",
    "./blocks/*/Component": "./src/blocks/*/Component.tsx",
    "./collections/*": "./src/collections/*/index.ts",
    "./components/*": "./src/components/*",
    "./fields/*": "./src/fields/*/index.ts",
    "./globals/*": "./src/globals/*/index.ts",
    "./helpers/*": "./src/helpers/*/index.ts",
    "./hooks/*": "./src/hooks/*/index.ts",
    "./plugins/*": "./src/plugins/*/index.ts",
    "./payload-types": "./src/payload-types.ts",
    "./payload-config": "./src/payload.config.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules bun.lockb",
    "format": "bun x biome format .",
    "format:fix": "bun x biome format --write .",
    "lint": "bun x biome lint .",
    "lint:fix": "bun x biome check --write .",
    "check-types": "tsc --noEmit",
    "generate:types": "PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test:integration": "TEST_DATABASE_URI=${TEST_DATABASE_URI:-postgresql://postgres:postgres@localhost:5432/newsspend_test} bun test test/"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@news-spend-media/env": "workspace:*",
    "@news-spend-media/mail": "workspace:*",
    "@news-spend-media/payload-cpanel-storage": "workspace:*",
    "@news-spend-media/utils": "workspace:*",
    "@payload-bites/audit-fields": "^1.7.0",
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/email-resend": "catalog:",
    "@payloadcms/graphql": "catalog:",
    "@payloadcms/live-preview-react": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/plugin-redirects": "catalog:",
    "@payloadcms/plugin-sentry": "catalog:",
    "@payloadcms/plugin-seo": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/ui": "catalog:",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "@sentry/nextjs": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "catalog:",
    "expo-server-sdk": "catalog:",
    "lucide-react": "^0.562.0",
    "next": "catalog:",
    "payload": "catalog:",
    "payload-blurhash-plugin": "^3.1.0",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-day-picker": "^9.8.0",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-tweet": "catalog:",
    "sharp": "catalog:",
    "slugify": "catalog:",
    "swr": "^2.3.4",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "ts-pattern": "^5.6.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@news-spend-media/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  },
  "watch": {
    "generate:types": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,tsx",
      "quiet": false
    }
  }
}
