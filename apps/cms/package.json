{
  "name": "@news-spend-media/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation\" next build",
    "ci": "bun run payload migrate && bun run build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation portless cms.newsspend next dev --turbopack",
    "dev:clean": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev",
    "dev:clean:turbo": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbo",
    "dev:turbo": "cross-env NODE_OPTIONS=\"--no-deprecation\" next dev --turbo",
    "format": "bun x biome format .",
    "format:fix": "bun x biome format --write .",
    "generate:importmap": "payload generate:importmap",
    "generate:schema": "payload-graphql generate:schema",
    "generate:types": "payload generate:types",
    "lint": "bun x biome lint .",
    "lint:fix": "bun x biome check --write .",
    "payload": "payload",
    "standalone-script": "node ./src/scripts/standalone-script.js",
    "start": "bun --bun next start",
    "start:node": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=768\" next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@news-spend-media/env": "workspace:*",
    "@news-spend-media/payload": "workspace:*",
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/db-sqlite": "catalog:",
    "@payloadcms/graphql": "catalog:",
    "@payloadcms/live-preview-react": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/plugin-redirects": "catalog:",
    "@payloadcms/plugin-sentry": "catalog:",
    "@payloadcms/plugin-seo": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@sentry/nextjs": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "babel-plugin-react-compiler": "^0.0.0",
    "cross-env": "^10.1.0",
    "graphql": "^16.10.0",
    "next": "catalog:",
    "payload": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-tweet": "catalog:",
    "require-in-the-middle": "^7.5.0",
    "sharp": "catalog:",
    "ssh2": "catalog:",
    "ssh2-sftp-client": "catalog:"
  },
  "devDependencies": {
    "@news-spend-media/config": "workspace:*",
    "@news-spend-media/tailwind-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
