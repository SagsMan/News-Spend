{
  "extends": "@news-spend-media/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": ["bun"]
  }
}
