{
  "expo": {
    "name": "News Spend",
    "slug": "news-spend-media",
    "scheme": "news-spend",
    "description": "News Spend Media is a news and media platform designed to empower people through the power of information. We believe that the right information should inspire action, create opportunities, and help people move closer to the future they envision. More than a traditional news app, News Spend Media combines informative content, interactive media experiences, and meaningful engagement opportunities that help users stay informed while progressing toward their personal aspirations through our unique Dream Fulfillment ecosystem.\n\nStay Informed. Stay Empowered.\n• Access breaking news and trending stories from Nigeria and around the world\n• Explore business, entertainment, lifestyle, sports, technology, politics, and more\n• Listen to selected radio stations available within the app\n• Watch engaging videos, interviews, and trailers\n• Earn Dream Points through reading news and participating in eligible activities\n• Track your progress toward goals and aspirations through the Dream Fulfillment ecosystem",
    "assetBundlePatterns": ["assets/images/*", "assets/icons/*"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icons/icon.png",
    "experiments": {
      "tsconfigPaths": true,
      "reactCompiler": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "link.newsspend.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "newspend.godetour.link",
              "pathPrefix": "/Mf4vgZvonH"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-video",
      "expo-image",
      "expo-asset",
      "expo-dev-client",
      "expo-localization",
      "expo-web-browser",
      "expo-secure-store",
      "@rnrepo/expo-config-plugin",
      "@react-native-community/datetimepicker",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "abiFilters": ["arm64-v8a", "armeabi-v7a"],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "pickFirst": [
                "lib/arm64-v8a/libNitroModules.so",
                "lib/armeabi-v7a/libNitroModules.so",
                "lib/x86/libNitroModules.so",
                "lib/x86_64/libNitroModules.so"
              ]
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00233D",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#00233D"
          },
          "imageWidth": 150
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.otf",
            "./assets/fonts/Inter-Medium.otf",
            "./assets/fonts/Inter-SemiBold.otf",
            "./assets/fonts/Inter-Bold.otf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow News Spend to access your photos to upload images for content reporting and identity verification.",
          "cameraPermission": "Allow News Spend to access your camera to take photos for identity verification and content reporting."
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "toolsButton": "false",
          "skipOnboarding": "true",
          "showMenuAtLaunch": "false"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "news-spend-media",
          "organization": "news-spend-media",
          "useNativeInit": true
        }
      ],
      [
        "react-native-share",
