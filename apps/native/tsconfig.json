{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["jest"],
    "strict": true,
    "paths": {
      "#/*": ["./src/*"],
      "#/images/*": ["./assets/images/*"],
      "~/*": ["./*"],
      "@/*": ["./*"]
    },
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
