{
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.11",
    "ultracite": "7.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x biome check --write"
    ]
  },
  "name": "turbo-payload",
  "scripts": {
    "build": "bun --filter @news-spend-media/cms build",
    "clean": "git clean -xdf node_modules",
    "dev": "bun --filter @news-spend-media/cms dev",
    "format": "bun x biome format .",
    "format:fix": "bun x biome format --write .",
    "lint": "bun x biome lint .",
    "lint:fix": "bun x biome check --write .",
    "typecheck": "bun --filter @news-spend-media/cms typecheck",
    "test": "turbo test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "test -z \"$EAS_BUILD\" && lefthook install || echo 'Skipping lefthook'"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "next": "16.3.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.1",
      "@types/node": "^24.13.3",
      "typescript": "^7.0.2",
      "payload": "3.88.0",
      "payloadcms": "3.88.0",
      "@payloadcms/db-postgres": "3.88.0",
      "@payloadcms/db-sqlite": "3.88.0",
      "@payloadcms/graphql": "3.88.0",
      "@payloadcms/live-preview-react": "3.88.0",
      "@payloadcms/next": "3.88.0",
      "@payloadcms/plugin-redirects": "3.88.0",
      "@payloadcms/plugin-seo": "3.88.0",
      "@payloadcms/plugin-cloud-storage": "3.88.0",
      "@payloadcms/plugin-sentry": "3.88.0",
      "@payloadcms/richtext-lexical": "3.88.0",
      "@payloadcms/ui": "3.88.0",
      "@payloadcms/email-resend": "3.88.0",
      "@orpc/client": "2.0.0-beta.28",
      "@orpc/contract": "2.0.0-beta.28",
      "@orpc/server": "2.0.0-beta.28",
      "@orpc/zod": "2.0.0-beta.28",
      "@orpc/openapi": "2.0.0-beta.28",
      "@orpc/ratelimit": "2.0.0-beta.28",
      "@orpc/pino": "2.0.0-beta.28",
      "@orpc/opentelemetry": "2.0.0-beta.28",
      "@orpc/publisher": "2.0.0-beta.28",
      "@orpc/tanstack-query": "2.0.0-beta.28",
      "@orpc/standard-server-fetch": "1.0.0-beta.7",
      "better-auth": "~1.6.30",
      "@better-auth/expo": "~1.6.30",
      "dotenv": "^17.2.2",
      "zod": "^4.4.3",
      "jose": "^5.9.6",
      "tailwindcss": "^4.3.0",
      "@tailwindcss/postcss": "^4.1.18",
      "postcss": "^8.5.6",
      "tw-animate-css": "^1.4.0",
      "sharp": "^0.35.3",
      "@sentry/nextjs": "10.70.0",
      "@sentry/node": "10.70.0",
      "react-tweet": "^3.3.0",
      "ssh2": "^1.17.0",
      "ssh2-sftp-client": "^12.1.0",
      "@hookform/resolvers": "^5.9.1",
      "date-fns": "^4.1.0",
      "react-hook-form": "^7.85.0",
      "tailwind-merge": "^3.4.0",
      "drizzle-kit": "^0.31.10",
      "@types/bun": "^1.3.14",
      "expo-server-sdk": "^7.1.0",
      "pg": "^8.18.0",
      "@types/pg": "^8.15.6",
      "slugify": "^1.6.6"
    }
  },
  "private": true,
  "overrides": {
    "@sentry/bun": "10.70.0",
    "@sentry/core": "10.70.0",
    "@sentry/nextjs": "10.70.0",
    "@sentry/node": "10.70.0",
    "@sentry/node-core": "10.70.0",
    "@sentry/opentelemetry": "10.70.0",
    "@sentry/types": "10.70.0",
    "@sentry/browser": "10.70.0",
    "@sentry/react": "10.70.0",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.11.1"
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "node-internet-radio@0.2.1": "patches/node-internet-radio@0.2.1.patch"
  }
}
